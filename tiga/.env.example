ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_turbo_v2_5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

METRICS_ENDPOINT=
BOOKING_WEBHOOK=

# Gmail API Configuration
# Download credentials.json from Google Cloud Console > APIs & Services > Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_USER_EMAIL=you@example.com
ADMIN_REPORT_EMAIL=you@example.com

# GitHub and Tiga agents
# Use owner/repository, for example Baliga04-dev/TIGA
GITHUB_REPOSITORY=Baliga04-dev/TIGA
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_SYNC_INTERVAL_MINUTES=1440

HOST=127.0.0.1
PORT=8000

# Extra browser origins allowed to call state-changing API routes (comma separated).
# localhost and 127.0.0.1 are always allowed.
ALLOWED_ORIGINS=
