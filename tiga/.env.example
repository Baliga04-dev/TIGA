ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_turbo_v2_5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

METRICS_ENDPOINT=
BOOKING_WEBHOOK=

# Gmail API Configuration
# Download credentials.json from Google Cloud Console > APIs & Services > Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_USER_EMAIL=you@example.com
ADMIN_REPORT_EMAIL=you@example.com

# GitHub and Tiga agents
# Use owner/repository, for example Baliga04-dev/TIGA
GITHUB_REPOSITORY=Baliga04-dev/TIGA
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_SYNC_INTERVAL_MINUTES=1440

HOST=127.0.0.1
PORT=8000

# Extra browser origins allowed to call state-changing API routes (comma separated).
# localhost and 127.0.0.1 are always allowed.
ALLOWED_ORIGINS=

# SQLite file for issues, outreach, suppressions and the audit log
TIGA_DB_PATH=tiga.db
# Private Learn service (leave empty on any shared/hosted copy)
TIGA_LEARN_ENABLED=
TIGA_LEARN_DIR=../learn_workspace

# Cold-email compliance and pacing. A real postal address (or PO box) is REQUIRED before anything is sent.
TIGA_POSTAL_ADDRESS=
TIGA_OUTREACH_DAILY_CAP=25
# Per-bot instruction files editable from the Crew page
TIGA_SKILLS_DIR=skills

# The bot writes the first draft; you only approve. Name signed on each mail and what you offer.
TIGA_SENDER_NAME=
TIGA_OFFER=websites and custom software for small businesses

# Overnight Analyst: collects 16:00-02:00, drafts once after 02:00 (local time). 0 turns it off.
TIGA_ANALYST_TICK_MINUTES=20
TIGA_ANALYST_DRAFTS_PER_MORNING=15
TIGA_TIMEZONE=Asia/Kolkata

# Recurring tasks: how often to check for due ones (0 turns them off) and how many may run a day.
TIGA_ROUTINE_TICK_SECONDS=60
TIGA_ROUTINE_DAILY_RUNS=24

# Which AI Tiga uses: auto = your Claude subscription through the claude CLI when installed (no API key,
# no extra cost), else OPENAI_API_KEY, else the free built-in rules. Options: auto, claude, openai, off.
TIGA_AI_PROVIDER=auto
TIGA_CLAUDE_MODEL=sonnet
TIGA_AI_DAILY_CALLS=150

# Billing (UPI QR on invoices) and your public portfolio link
TIGA_UPI_ID=
TIGA_BUSINESS_NAME=
TIGA_PORTFOLIO_URL=

# Tiga Bridge extension secret (paste the same value in the extension's options). Empty turns the bridge off.
TIGA_BRIDGE_TOKEN=
